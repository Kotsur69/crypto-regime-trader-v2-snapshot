# ============================================
# CRYPTO TRADING BOT - ENVIRONMENT VARIABLES
# ============================================
# Skopiuj ten plik jako .env i wypełnij danymi
# cp .env.example .env

# Binance Testnet API Keys
# Uzyskaj z: https://testnet.binance.vision/
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_api_secret_here

# Opcjonalnie: Discord/Telegram webhook dla notyfikacji
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
